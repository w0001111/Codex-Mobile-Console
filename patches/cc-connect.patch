+package core
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"strings"
+	"time"
+)
+
+const consoleRouterName = "console-router"
+
+func parseConsoleRoute(output string) (bool, string, error) {
+	var result struct {
+		Handled  *bool  `json:"handled"`
+		Response string `json:"response"`
+	}
+	if err := json.Unmarshal([]byte(output), &result); err != nil || result.Handled == nil {
+		return true, "", fmt.Errorf("invalid console route response")
+	}
+	if (*result.Handled && strings.TrimSpace(result.Response) == "") || (!*result.Handled && result.Response != "") {
+		return true, "", fmt.Errorf("ambiguous console route response")
+	}
+	return *result.Handled, result.Response, nil
+}
+
+// Chunk before the platform boundary, preserving every Unicode code point.
+// Each platform remains responsible for its own formatting and API limits.
+func (e *Engine) replyConsole(p Platform, replyCtx any, text string) {
+	runes := []rune(text)
+	const size = 1000
+	total := (len(runes) + size - 1) / size
+	for index, start := 0, 0; start < len(runes); index, start = index+1, start+size {
+		end := min(start+size, len(runes))
+		if err := e.replyWithError(p, replyCtx, string(runes[start:end])); err != nil {
+			// An uncertain API failure may already have delivered this chunk.
+			// Never automatically resend it or silently claim complete delivery.
+			e.reply(p, replyCtx, e.i18n.Tf(MsgConsoleIncomplete, index, total))
+			return
+		}
+	}
+}
+
+func (e *Engine) routeConsoleMessage(p Platform, msg *Message, content string) bool {
+	if e.commands == nil || strings.HasPrefix(content, "/") || strings.HasPrefix(content, "!") {
+		return false
+	}
+	command, ok := e.commands.Resolve(consoleRouterName)
+	if !ok || command.Source != "config" || len(command.Argv) == 0 {
+		return false
+	}
+	// A configured console route fails closed before reaching any Agent.
+	if msg.Platform == "" || msg.Platform != p.Name() || msg.UserID == "" || msg.SessionKey == "" || msg.MessageID == "" || !e.isAdmin(msg.UserID) {
+		e.reply(p, msg.ReplyCtx, e.i18n.T(MsgConsoleDenied))
+		return true
+	}
+	ctx, cancel := context.WithTimeout(e.ctx, 60*time.Second)
+	defer cancel()
+	output, err := runArgvCommand(ctx, command, argvCommandInput{
+		Version: 1, Project: e.name, Platform: msg.Platform,
+		SessionKey: msg.SessionKey, UserID: msg.UserID, MessageID: msg.MessageID,
+		Args:           []string{content},
+		HasAttachments: len(msg.Images) > 0 || len(msg.Files) > 0 || msg.Location != nil || msg.Audio != nil,
+	})
+	handled, response := true, ""
+	if err == nil {
+		handled, response, err = parseConsoleRoute(output)
+	}
+	if err != nil {
+		handled, response = true, e.i18n.T(MsgConsoleUnavailable)
+	}
+	if handled {
+		e.replyConsole(p, msg.ReplyCtx, response)
+	}
+	return handled
+}
