+		fmt.Print(`{"handled":false`)
+	default:
+		_ = json.NewEncoder(os.Stdout).Encode(map[string]any{"handled": true, "response": in.Platform + "|" + in.Args[0]})
+	}
+	os.Exit(0)
+}
