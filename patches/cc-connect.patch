+func TestConsoleRouteStrictFallback(t *testing.T) {
+	for _, s := range []string{`{}`, `null`, `{"handled":true}`, `{"handled":false,"response":"sent"}`, `{"handled":false} trailing`} {
+		if _, _, err := parseConsoleRoute(s); err == nil {
