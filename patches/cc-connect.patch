+package core
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"os"
+	"strings"
+	"testing"
+	"time"
+)
+
+// The test executable is the external command boundary; no shell or model runs.
+func TestArgvCommandHelper(t *testing.T) {
+	if os.Getenv("CC_ARGV_TEST_HELPER") != "1" {
+		return
+	}
+	var input argvCommandInput
+	if err := json.NewDecoder(os.Stdin).Decode(&input); err != nil {
+		os.Exit(2)
+	}
+	if len(input.Args) > 0 && input.Args[0] == "delay" {
+		time.Sleep(10 * time.Second)
+	}
+	if len(input.Args) > 0 && input.Args[0] == "fail" {
+		fmt.Fprint(os.Stderr, "private-secret-do-not-relay")
+		os.Exit(3)
+	}
+	if len(input.Args) > 0 && input.Args[0] == "long-output" {
+		fmt.Print(strings.Repeat("中文🙂", 7000) + "END-OF-REPLY")
+		os.Exit(0)
+	}
+	if len(input.Args) > 0 && input.Args[0] == "overflow" {
+		fmt.Print(strings.Repeat("a", (4<<20)+1))
+		os.Exit(0)
+	}
+	_ = json.NewEncoder(os.Stdout).Encode(input)
+	os.Exit(0)
+}
+
+func argvTestCommand(t *testing.T) *CustomCommand {
+	t.Helper()
+	t.Setenv("CC_ARGV_TEST_HELPER", "1")
+	return &CustomCommand{Name: "control", Argv: []string{os.Args[0], "-test.run=^TestArgvCommandHelper$"}, WorkDir: t.TempDir()}
+}
+
+func TestArgvCommand_InputIsJSONNotShell(t *testing.T) {
+	command := argvTestCommand(t)
+	input := argvCommandInput{Version: 1, Project: "p", Platform: "test", UserID: "u", SessionKey: "s", MessageID: "m",
+		Args: []string{"$(touch NEVER_CREATE)", "`; echo unsafe", "中文", "line\nbreak"}}
+	output, err := runArgvCommand(context.Background(), command, input)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var got argvCommandInput
+	if err := json.Unmarshal([]byte(output), &got); err != nil {
+		t.Fatal(err)
+	}
+	if fmt.Sprint(got) != fmt.Sprint(input) {
+		t.Fatalf("input changed: %v", got)
+	}
+	if _, err := os.Stat(command.WorkDir + "/NEVER_CREATE"); !os.IsNotExist(err) {
+		t.Fatal("shell payload executed")
+	}
+}
+
+func TestArgvCommand_FailureDoesNotExposeDiagnostics(t *testing.T) {
+	output, err := runArgvCommand(context.Background(), argvTestCommand(t), argvCommandInput{Args: []string{"fail"}})
+	if err == nil || output != "" || strings.Contains(err.Error(), "private-secret") {
+		t.Fatalf("unsafe error: %q %v", output, err)
+	}
+}
+
+func TestArgvCommand_Deadline(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), 100*time.Millisecond)
+	defer cancel()
+	_, err := runArgvCommand(ctx, argvTestCommand(t), argvCommandInput{Args: []string{"delay"}})
+	if err == nil || ctx.Err() == nil {
+		t.Fatalf("expected timeout: %v", err)
+	}
+}
+
+func TestArgvCommand_OutputCap(t *testing.T) {
+	var output cappedCommandOutput
+	n, err := output.Write([]byte(strings.Repeat("a", maxCommandOutputBytes+1)))
+	if n != maxCommandOutputBytes+1 || err != nil || output.Len() != maxCommandOutputBytes || !output.overflow {
+		t.Fatal("output was not safely capped and drained")
+	}
+}
+
+func TestArgvCommandFullReplyBeyondOldCaps(t *testing.T) {
+	c := argvTestCommand(t)
+	p := &stubPlatformEngine{n: "test"}
+	e := newTestEngine()
+	e.executeArgvCommand(p, &Message{Platform: "test", UserID: "u", MessageID: "m"}, c, []string{"long-output"})
+	got := p.getSent()
+	want := strings.Repeat("中文🙂", 7000) + "END-OF-REPLY"
+	if len(got) != 1 || got[0] != want {
+		t.Fatal("full reply was lost before platform chunking")
+	}
+}
+func TestArgvCommandOversizedOutputFailsWithoutPartialReply(t *testing.T) {
+	output, err := runArgvCommand(context.Background(), argvTestCommand(t), argvCommandInput{Args: []string{"overflow"}})
+	if err == nil || output != "" {
+		t.Fatal("oversized output must fail explicitly, not return a partial answer")
+	}
+}
