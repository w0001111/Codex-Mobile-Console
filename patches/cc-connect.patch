+type consoleFailPlatform struct {
+	*stubPlatformEngine
+	count int
+}
+
+func (p *consoleFailPlatform) Reply(ctx context.Context, r any, text string) error {
+	p.count++
+	if p.count == 2 {
+		return errors.New("synthetic delivery failure")
+	}
+	return p.stubPlatformEngine.Reply(ctx, r, text)
+}
+func TestConsoleChunkFailureDoesNotResend(t *testing.T) {
+	e := newTestEngine()
+	p := &consoleFailPlatform{stubPlatformEngine: &stubPlatformEngine{n: "telegram"}}
+	e.replyConsole(p, nil, strings.Repeat("a", 3000))
+	got := p.getSent()
+	if p.count != 3 || len(got) != 2 || !strings.Contains(got[1], "1/3 chunks confirmed") {
+		t.Fatal("delivery failure not explicit")
+	}
+}
