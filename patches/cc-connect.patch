+func TestConsoleRouterAllPlatforms(t *testing.T) {
+	t.Setenv("CC_CONSOLE_HELPER", "1")
+	// Registry names in pinned upstream v1.4.1. No live accounts or models.
+	for _, platform := range []string{"feishu", "telegram", "discord", "slack", "dingtalk", "wecom", "weixin", "qq", "qqbot", "line", "weibo", "max", "matrix", "webex", "lark", "wps-xiezuo"} {
+		t.Run(platform, func(t *testing.T) {
+			e := newTestEngine()
+			e.SetAdminFrom("owner")
+			p := &stubPlatformEngine{n: platform}
+			e.AddArgvCommand(consoleRouterName, "console", []string{os.Args[0], "-test.run=^TestConsoleRouterHelper$"}, t.TempDir(), "config")
+			msg := &Message{Platform: platform, UserID: "owner", SessionKey: "session", MessageID: "message", Content: "quoted context must not override user input"}
+			text := "hello\n$(touch NEVER_CREATE)"
+			if !e.routeConsoleMessage(p, msg, text) {
+				t.Fatal("not routed")
+			}
+			if got := p.getSent(); len(got) != 1 || got[0] != platform+"|"+text {
+				t.Fatalf("changed text: %v", got)
+			}
+			if e.routeConsoleMessage(p, msg, "fallback") {
+				t.Fatal("explicit fallback failed")
+			}
+			if !e.routeConsoleMessage(p, msg, "broken") {
+				t.Fatal("ambiguous fallback allowed")
+			}
+			msg.UserID = "stranger"
+			if !e.routeConsoleMessage(p, msg, "hello") {
+				t.Fatal("unauthorized message reached agent")
+			}
+		})
+	}
+}
