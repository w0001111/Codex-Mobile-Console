+package core
+
+import "strings"
+
+// localListenHost keeps management surfaces local unless explicitly configured.
+func localListenHost(host string) string {
+	host = strings.TrimSpace(host)
+	if host == "" {
+		return "127.0.0.1"
+	}
+	return host
+}
