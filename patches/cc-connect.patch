+func TestConsoleLongReplyAndMissingIdentity(t *testing.T) {
+	e := newTestEngine()
+	p := &stubPlatformEngine{n: "telegram"}
+	text := strings.Repeat("中文🙂", 3500) + "END"
+	e.replyConsole(p, nil, text)
+	if strings.Join(p.getSent(), "") != text {
+		t.Fatal("lost reply body")
+	}
+	for _, part := range p.getSent() {
+		if len([]rune(part)) > 1000 {
+			t.Fatal("chunk too large")
+		}
+	}
+	e.SetAdminFrom("owner")
+	e.AddArgvCommand(consoleRouterName, "console", []string{"DO_NOT_EXECUTE"}, t.TempDir(), "config")
+	for _, msg := range []*Message{
+		{Platform: "telegram", UserID: "owner", SessionKey: "s"},
+		{Platform: "feishu", UserID: "owner", SessionKey: "s", MessageID: "m"},
+	} {
+		if !e.routeConsoleMessage(p, msg, "hello") {
+			t.Fatal("invalid identity fell back")
+		}
+	}
+	if e.routeConsoleMessage(p, &Message{}, "/whoami") {
+		t.Fatal("intercepted upstream command")
+	}
+}
