+func TestManagementAndBridge_DefaultLoopback(t *testing.T) {
+	m := NewManagementServer(0, "test-token", nil)
+	m.Start()
+	defer m.Stop()
+	b := NewBridgeServer(1, "test-token", "", nil)
+	b.port = 0 // ephemeral port; constructor normally substitutes the default
+	b.Start()
+	defer b.Stop()
+	for name, addr := range map[string]string{"management": m.server.Addr, "bridge": b.server.Addr} {
+		host, _, err := net.SplitHostPort(addr)
+		if err != nil || host != "127.0.0.1" {
+			t.Errorf("%s unexpectedly exposes non-loopback listener %q: %v", name, addr, err)
+		}
+	}
+}
+
+func TestManagementAndBridge_ExplicitListenHost(t *testing.T) {
+	for _, host := range []string{"::1", "127.0.0.2", "  "} {
+		m := NewManagementServer(0, "test-token", nil)
+		m.SetListenHost(host)
+		m.Start()
+		m.Stop()
+		b := NewBridgeServer(1, "test-token", "", nil)
+		b.port = 0
+		b.SetListenHost(host)
+		b.Start()
+		b.Stop()
+		want := host
+		if host == "  " {
+			want = "127.0.0.1"
+		}
+		for _, addr := range []string{m.server.Addr, b.server.Addr} {
+			got, _, err := net.SplitHostPort(addr)
+			if err != nil || got != want {
+				t.Errorf("host %q produced %q: %v", host, addr, err)
+			}
+		}
+	}
+}
