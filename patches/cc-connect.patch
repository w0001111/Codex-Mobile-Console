+package core
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"strings"
+	"time"
+)
+
+// argvCommandInput deliberately excludes credentials, attachments and quoted
+// platform content. Identity is supplied by the authenticated platform adapter.
+type argvCommandInput struct {
+	Version        int      `json:"version"`
+	Project        string   `json:"project"`
+	Platform       string   `json:"platform"`
+	SessionKey     string   `json:"session_key"`
+	UserID         string   `json:"user_id"`
+	MessageID      string   `json:"message_id"`
+	Args           []string `json:"args"`
+	HasAttachments bool     `json:"has_attachments,omitempty"`
+}
+
+// cappedCommandOutput continues draining the child after reaching the cap.
+const maxCommandOutputBytes = 4 << 20 // resource guard; never return a silently cut reply
+
+type cappedCommandOutput struct {
+	buffer   bytes.Buffer
+	overflow bool
+}
+
+// Do not embed bytes.Buffer: its promoted ReadFrom would let io.Copy bypass Write.
+func (b *cappedCommandOutput) Len() int       { return b.buffer.Len() }
+func (b *cappedCommandOutput) String() string { return b.buffer.String() }
+
+func (b *cappedCommandOutput) Write(p []byte) (int, error) {
+	n := len(p)
+	remaining := maxCommandOutputBytes - b.Len()
+	if n > remaining {
+		b.overflow = true
+	}
+	if remaining > 0 {
+		_, _ = b.buffer.Write(p[:min(len(p), remaining)])
+	}
+	return n, nil
+}
+
+func runArgvCommand(ctx context.Context, command *CustomCommand, input argvCommandInput) (string, error) {
+	if len(command.Argv) == 0 || strings.TrimSpace(command.Argv[0]) == "" {
+		return "", fmt.Errorf("empty executable")
+	}
+	data, err := json.Marshal(input)
+	if err != nil || len(data) > 32768 {
+		return "", fmt.Errorf("invalid or oversized command input")
+	}
+	cmd := exec.CommandContext(ctx, command.Argv[0], command.Argv[1:]...)
+	cmd.Dir = command.WorkDir
+	cmd.Stdin = bytes.NewReader(data)
+	var output cappedCommandOutput
+	cmd.Stdout = &output
+	// Child diagnostics may contain credentials; never relay stderr to chat.
+	cmd.Stderr = io.Discard
+	cmd.Cancel = func() error { return cmd.Process.Signal(os.Interrupt) }
+	cmd.WaitDelay = 2 * time.Second
+	if err := cmd.Run(); err != nil {
+		// Do not expose arbitrary subprocess arguments or provider diagnostics.
+		return "", fmt.Errorf("external command failed")
+	}
+	if output.overflow {
+		return "", fmt.Errorf("external command output exceeds resource limit")
+	}
+	return strings.ToValidUTF8(output.String(), ""), nil
+}
+
+func (e *Engine) executeArgvCommand(p Platform, msg *Message, command *CustomCommand, args []string) {
+	ctx, cancel := context.WithTimeout(e.ctx, 60*time.Second)
+	defer cancel()
+	output, err := runArgvCommand(ctx, command, argvCommandInput{
+		Version: 1, Project: e.name, Platform: msg.Platform,
+		SessionKey: msg.SessionKey, UserID: msg.UserID,
+		MessageID: msg.MessageID, Args: args,
+	})
+	if ctx.Err() != nil {
+		e.reply(p, msg.ReplyCtx, e.i18n.Tf(MsgCommandExecTimeout, command.Name))
+		return
+	}
+	if err != nil {
+		e.reply(p, msg.ReplyCtx, e.i18n.Tf(MsgCommandExecError, command.Name, ""))
+		return
+	}
+	output = strings.TrimSpace(output)
+	if output == "" {
+		output = e.i18n.T(MsgCommandExecSuccess)
+	}
+	e.reply(p, msg.ReplyCtx, output)
+}
